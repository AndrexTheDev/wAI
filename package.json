{
  "name": "wai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "wAI - Umgebungs-Gedächtnisanker / Environmental Memory Anchor. Offline-first Android app + bilingual landing page + legal & growth kit.",
  "license": "UNLICENSED",
  "author": "AndrexTheDev <hippie.highho@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "status": "node tools/wai.mjs status",
    "dev:landing": "npm run dev -w @wai/landing",
    "dev:app": "npm run dev -w @wai/app",
    "build": "node tools/build-all.mjs",
    "build:landing": "npm run build -w @wai/landing",
    "build:app": "npm run build -w @wai/app",
    "build:android": "bash tools/build-android.sh",
    "verify": "npm run typecheck && npm test && npm run smoke && npm run check:android && npm run check:store && npm run check:claims",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/app && tsc --noEmit -p packages/landing",
    "test": "npm test -w @wai/shared",
    "smoke": "npm run smoke:render -w @wai/app && npm run smoke:render -w @wai/landing",
    "check:android": "node tools/check-android-assets.mjs",
    "ci:android": "node tools/wai.mjs ci:android",
    "ci:status": "node tools/wai.mjs ci:status",
    "ci:logs": "node tools/wai.mjs ci:logs",
    "release": "bash tools/release.sh",
    "keystore": "bash tools/make-keystore.sh",
    "license:keygen": "node tools/license-cli.mjs keygen",
    "license:issue": "node tools/license-cli.mjs issue",
    "license:verify": "node tools/license-cli.mjs verify",
    "check:store": "node tools/check-store-listing.mjs",
    "check:claims": "node tools/check-claims.mjs",
    "screenshots": "node tools/capture-store-screenshots.mjs",
    "build:map": "node tools/build-map-pack.mjs"
  },
  "devDependencies": {
    "playwright": "1.49",
    "yaml": "^2.9.1"
  }
}
