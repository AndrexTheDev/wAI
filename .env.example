# ─── wAI build configuration ────────────────────────────────────────────────
# Copy to .env.local (never committed) or set these in GitHub Actions secrets.
# Every value has a working default – the app builds and runs without any env.

# ── App ──────────────────────────────────────────────────────────────────────
# Public Ed25519 key that verifies Pro licences. Must match
# tools/keys/issuer.public.json. Override only when rotating the issuer key.
VITE_WAI_ISSUER_KEY=ca4b28dddedf05fe9143c2981ee90be822e8d27eda9464ced8ec3772a1c48371
# Additional accepted keys (comma separated) for key rotation.
VITE_WAI_ISSUER_KEY_FALLBACKS=
# Canonical website (legal pages, download, support).
VITE_WEBSITE_URL=https://andrexthedev.github.io/wAI

# ── Landing page ─────────────────────────────────────────────────────────────
# Direct APK link. Leave empty to point at the GitHub release page.
VITE_APK_URL=
# SHA-256 of that APK, shown next to the download button.
VITE_APK_SHA256=
# Where "download" goes when VITE_APK_URL is empty.
VITE_RELEASES_URL=https://github.com/AndrexTheDev/wAI/releases/latest
# Embedded app location (relative path keeps it same-origin and offline-capable).
VITE_WEBAPP_URL=/app/
# Privacy-friendly analytics domain (optional, aggregate only, no cookies).
VITE_PLAUSIBLE_DOMAIN=
